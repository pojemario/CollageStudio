     <rdf:li xml:lang="x-default">das Kolaž</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Heritage film look for raw files (Canon R6, Fujifilm X100VI, …) on the default Adobe Color profile: amber skin, rust and brick reds, deep muted greens, soft contrast over warm lifted blacks.</rdf:li>
    </rdf:Alt>
   </crs:Description>
